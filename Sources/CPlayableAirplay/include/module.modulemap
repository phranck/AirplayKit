//
//  module.modulemap
//  Makes the header a Clang module, which is what lets the Swift wrapper reach
//  it without a bridging header, on macOS and on Linux alike.
//
//  The C prefix is the usual mark for the layer underneath: the module a Swift
//  caller imports is PlayableAirplay, and this is what that module is built on.
//
//  Copyright © 2026 cocoa:naut. All rights reserved.
//

module CPlayableAirplay {
    header "PlayableAirplay.h"
    export *

    // Internal to this package. It is named here so the tests can reach the one
    // piece that can be checked without a receiver on the network, and it is
    // not part of what a consumer is offered.
    header "receiver_name.h"
}
