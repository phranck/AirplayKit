+# A RAOP record names the same facts under shorter keys. This receiver keeps one
+# set of properties, so the RAOP view is derived from it rather than kept beside
+# it, and only from keys that are actually set: a made up encryption or metadata
+# capability would have a sender ask for something this receiver cannot do.
+RAOP_KEYS_FROM_AIRPLAY = {
+    "ft": "features",
+    "sf": "flags",
+    "am": "model",
+    "vs": "srcvers",
+    "cn": "cn",
+    "pk": "pk",
+    "ch": "ch",
+}
+
+# Keys that belong to the AirPlay record alone, so the RAOP view drops them.
+AIRPLAY_ONLY_KEYS = ("ch", "cn", "sf")
+
+
+def encode_txt(props):
+    """Pack properties the way DNS-SD carries them, each entry counted."""
+    blob = b""
+    for key, value in props.items():
+        entry = f"{key}={value}".encode()
+        blob += bytes([len(entry)]) + entry
+    return blob
+
+
+def txt_records():
+    """The two service records this receiver stands for, as a sender reads them.
+
+    A macOS sender asks `/info?txtAirPlay&txtRAOP` before it pairs, and it goes
+    no further when the answer carries neither. Returns the AirPlay record and
+    the RAOP one, both packed.
+    """
+    airplay = {key: value for key, value in mdns_props.items()
+               if key not in AIRPLAY_ONLY_KEYS}
+
+    raop = {short: mdns_props[long] for short, long in RAOP_KEYS_FROM_AIRPLAY.items()
+            if long in mdns_props}
+    raop["tp"] = "UDP"
+    raop["vn"] = "65537"
+
+    return encode_txt(airplay), encode_txt(raop)
+
